{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "https://www.picklerollcall.com/level-check", "permanent": false },
    { "source": "/level-check", "destination": "https://www.picklerollcall.com/level-check", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
